# Культурный гид — добавить в ваш Caddyfile и заменить kulturgid.duckdns.org на свой поддомен.
# Сайт — статические файлы из ветки gh-pages, их раз в 2 минуты обновляет update-site.sh.
kulturgid.duckdns.org {
	root * /srv/sites/culture-guide
	encode zstd gzip

	# Папку git наружу не отдаём.
	@git path /.git /.git/*
	respond @git 404

	# index.html и список городов — всегда свежие (телефоны не застрянут на старой версии);
	# файлы с хэшем в имени — навсегда; карта, озвучка, фото — на сутки.
	@fresh path / /index.html /data/cities.json
	header @fresh Cache-Control "no-cache"
	@hashed {
		path /assets/* /data/*.json
		not path /data/cities.json
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@media path /map/* /audio/* /photos/* /og.jpg
	header @media Cache-Control "public, max-age=86400"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	file_server
}
