{
  "name": "culture-guide-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Культурный гид — путеводитель по историческим городам России",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "content": "tsx tools/build-content.ts",
    "content:check": "tsx tools/build-content.ts --check",
    "predev": "npm run content",
    "dev": "vite",
    "prebuild": "npm run content",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "check": "npm run content:check && npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "dependencies": {
    "maplibre-gl": "6.15.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
